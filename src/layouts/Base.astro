---
import { ogImagePath } from '../lib/og';
import '../styles/global.css';
import type { Lang } from '../data/profile';
import { profile, education } from '../data/profile';
import { stripMarks } from '../data/sketches';
import ToTop from '../components/ToTop.astro';
import { getImage } from 'astro:assets';
import photo from '../assets/rossmel.jpg';
import fontDisplay from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import fontText from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta equivalente en el otro idioma (para hreflang y el switch ES/EN). */
  altPath: string;
  /** Páginas "limpias" (CV) no cargan animaciones ni cursor. */
  plain?: boolean;
  /** 'article' en los artículos del blog. */
  ogType?: 'website' | 'article';
  /** Sin versión en el otro idioma (artículos): no se emite hreflang alternativo. */
  noAlt?: boolean;
  /** Solo artículos: fechas y etiquetas para article:* */
  published?: Date;
  modified?: Date;
  tags?: string[];
}
const { lang, title, description, altPath, plain = false, ogType = 'website', noAlt = false, published, modified, tags = [] } = Astro.props;
// Cloudflare Web Analytics: token público, se define en Pages → Settings → Variables (build).
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role[lang]}`;
const desc = stripMarks(description ?? profile.headline[lang]);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altPath, Astro.site);
const photoUrl = new URL((await getImage({ src: photo, width: 512, format: 'jpg' })).src, Astro.site).href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
// Datos estructurados: ayudan a que Google asocie "Rossmel Abasto" con este sitio y sus perfiles.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${profile.portfolioUrl}/#person`,
  name: profile.name,
  givenName: 'Rossmel',
  familyName: 'Abasto',
  jobTitle: profile.role[lang],
  description: stripMarks(profile.headline[lang]),
  image: photoUrl,
  email: `mailto:${profile.email}`,
  url: profile.portfolioUrl,
  sameAs: [...Object.values(profile.links).filter(Boolean), profile.cvUrl],
  address: { '@type': 'PostalAddress', addressLocality: 'Cochabamba', addressCountry: 'BO' },
  alumniOf: [...new Set(education.map((e) => e.school))].map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  knowsAbout: ['React', 'Next.js', 'TypeScript', 'React Native', 'Node.js', 'Python', 'FastAPI', 'RAG', 'LLM', 'Linux'],
  knowsLanguage: ['es', 'en'],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  alternateName: ['Rossmel', 'rossmel.com', `${profile.name} — Portfolio`],
  url: profile.portfolioUrl,
  inLanguage: ['es', 'en'],
  author: { '@id': `${profile.portfolioUrl}/#person` },
};
// Imagen para compartir: la propia de la página (public/og/…) o la general
const ogImage = new URL(ogImagePath(Astro.url.pathname), Astro.site);
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    {!noAlt && <link rel="alternate" hreflang={lang} href={canonical} />}
    {!noAlt && <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alt} />}
    {!noAlt && <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : alt} />}
    <meta name="author" content={profile.name} />
    <link rel="alternate" type="application/rss+xml" title={lang === 'es' ? 'Blog de Rossmel Abasto' : "Rossmel Abasto's blog"} href={lang === 'es' ? '/blog/rss.xml' : '/en/blog/rss.xml'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_BO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_BO'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
    {published && <meta property="article:author" content={profile.portfolioUrl} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />}
    <!-- Tema y movimiento antes de pintar: evita parpadeos -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          // Oscuro por defecto (el diseño está pensado dark-first); respeta la elección guardada.
          if (t !== 'light') t = 'dark';
          root.dataset.theme = t;
          if (sessionStorage.getItem('preloaded') === '1') root.classList.add('booted');
        } catch (e) {}
        try {
          // 'reduced' forzado por el botón del header, o si no, lo que diga el sistema.
          var m = localStorage.getItem('motion');
          var reduced = m === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.dataset.motion = reduced ? 'reduced' : 'auto';
          if (!reduced) {
            // Esconde el nombre del hero hasta que animations.ts arranque su animación (heroIntro
            // la quita en el mismo tick). Si algo falla, se revela sola a los 3 s.
            root.classList.add('hero-pending');
            setTimeout(function () { root.classList.remove('hero-pending'); }, 3000);
          }
        } catch (e) {}
      })();
    </script>
    <noscript><style>[data-preloader]{display:none!important}[data-hero-title],[data-hero-fade]{opacity:1!important}</style></noscript>
    <style is:global>
      @view-transition { navigation: auto; }
    </style>
    {cfBeacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })}></script>
    )}
    <slot name="head" />
  </head>
  <body class={plain ? '' : 'cursor-none-fine'}>
    <slot />
    {!plain && <div class="grain" aria-hidden="true"></div>}
    {!plain && <div class="cursor" data-cursor aria-hidden="true"></div>}
    {!plain && <ToTop lang={lang} />}
    {!plain && (
      <script>
        import { initAnimations } from '../scripts/animations';
        initAnimations();
      </script>
    )}
  </body>
</html>
