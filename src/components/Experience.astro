---
import type { Lang } from '../data/profile';
import { experience } from '../data/profile';
import { t, fmtMonth, paths } from '../data/i18n';
import Sketch from './Sketch.astro';
import Marked from './Marked.astro';
import SketchFlight from './SketchFlight.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const jobs = experience.filter((e) => !e.draft);
---
<section id="experience" class="relative overflow-hidden px-5 py-16 md:px-10 md:py-32">
  <SketchFlight icon="laptop" seed={101} variant={2} class="pointer-events-none absolute right-4 h-auto w-[48vw] max-w-[26rem] text-accent opacity-80 md:right-10 top-16" />
  <h2 class="kicker mb-10">{s.experience.kicker}</h2>
  <ol data-stack class="border-t border-line md:hidden">
    {jobs.map((job) => (
      <li data-stack-item class="border-b border-line">
        <div class="py-3">
          <span class="kicker block text-[0.7rem]">{fmtMonth(job.start, lang)} — {fmtMonth(job.end, lang)}</span>
          <h3 data-stack-name class="display mt-1 text-2xl font-semibold">{job.company[lang]}</h3>
        </div>
        <div data-stack-body>
          <div class="pb-5">
            <p class="text-sm text-accent">{job.role[lang]} · {job.type[lang]}</p>
            <p class="mt-3 text-fg/85"><Marked text={job.summary[lang]} /></p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {job.stack.map((x) => <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[0.7rem] text-muted">{x}</li>)}
            </ul>
            <a href={paths.cv(lang)} class="mt-4 inline-block font-mono text-xs text-accent underline-offset-4 hover:underline">{s.experience.fullCv} →</a>
          </div>
        </div>
      </li>
    ))}
  </ol>
  <div data-timeline class="relative hidden md:block">
    <div class="absolute left-0 top-0 h-full w-px bg-line md:left-[25%]"></div>
    <div data-progress class="absolute left-0 top-0 h-full w-px origin-top bg-accent md:left-[25%]"></div>
    {jobs.map((job) => (
      <article class="relative grid gap-6 pb-24 pl-8 md:grid-cols-4 md:pl-0">
        <span class="absolute left-[-4px] top-2 h-2 w-2 rounded-full bg-accent md:left-[calc(25%-4px)]"></span>
        <div class="kicker md:pr-10 md:text-right" data-reveal>
          {fmtMonth(job.start, lang)} — {fmtMonth(job.end, lang)}
          <br /><span class="normal-case tracking-normal">{job.type[lang]}</span>
          {!job.end && (
            <span class="mt-4 flex items-center gap-1 text-accent md:justify-end" aria-hidden="true">
              <span class="font-hand text-3xl normal-case tracking-normal">{s.experience.now}</span>
              <Sketch name="hook" seed={3} class="h-10 w-12 -scale-x-100" />
            </span>
          )}
        </div>
        <div class="md:col-span-3 md:pl-12">
          <h3 data-split class="display text-4xl font-semibold md:text-6xl">{job.company[lang]}</h3>
          <p class="mt-3 text-accent" data-reveal>{job.role[lang]}</p>
          <p class="mt-6 max-w-2xl text-lg text-fg/85" data-reveal><Marked text={job.summary[lang]} /></p>
          <ul class="mt-8 max-w-2xl space-y-3 text-muted">
            {job.bullets[lang].map((b) => <li class="flex gap-3" data-reveal><span class="text-accent">→</span><span>{b}</span></li>)}
          </ul>
          <ul class="mt-8 flex flex-wrap gap-2">
            {job.stack.map((x) => <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{x}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
