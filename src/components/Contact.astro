---
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { t, paths } from '../data/i18n';
import Logo from './Logo.astro';
import ContactForm from './ContactForm.astro';
import Sketch from './Sketch.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const socials = [
  ['GitHub', profile.links.github],
  ['LinkedIn', profile.links.linkedin],
  ['GitLab', profile.links.gitlab],
].filter(([, href]) => href);
---
<section id="contact" class="relative overflow-hidden px-5 pb-10 pt-16 md:px-10 md:pt-32">
  <Sketch name="flight" seed={23} draw="scrub" class="pointer-events-none absolute right-4 top-10 h-auto w-[55vw] max-w-[28rem] text-accent opacity-80 md:right-10 md:top-16 md:w-[32vw]" />
  <p class="kicker mb-10">{s.contact.kicker}</p>
  <h2 data-split class="display text-[13vw] font-bold uppercase md:text-[clamp(4.8rem,10vw,9rem)]">{s.contact.title}</h2>
  <div class="relative mt-16 flex flex-wrap items-center gap-4">
    <span class="pointer-events-none absolute -top-14 left-4 flex items-end gap-1 text-accent md:-top-16 md:left-8" aria-hidden="true">
      <Sketch name="hook" seed={31} class="h-12 w-14 -scale-x-100" />
      <span class="font-hand -translate-y-6 text-3xl">{s.contact.hand}</span>
    </span>
    <a data-magnetic href={`mailto:${profile.email}`} class="display inline-flex items-center rounded-full bg-accent px-8 py-6 text-xl font-semibold text-accent-ink md:text-3xl">{profile.email}</a>
    <button data-magnetic data-copy={profile.email} data-copied={s.contact.copied} type="button" class="rounded-full border border-line px-6 py-4 font-mono text-sm hover:border-fg">{s.contact.copy}</button>
    <a data-magnetic href={paths.cvPdf(lang)} download class="rounded-full border border-line px-6 py-4 font-mono text-sm hover:border-fg">{s.contact.cv} ↓</a>
  </div>
  <ContactForm lang={lang} title={s.contact.formTitle} class="mt-20" />
  <footer class="mt-40 flex flex-col justify-between gap-6 border-t border-line pt-6 font-mono text-xs text-muted md:flex-row">
    <span class="flex items-center gap-3"><Logo class="h-5 w-5 text-accent" />© {new Date().getFullYear()} {profile.name}. {s.footer}<Sketch name="cup" seed={2} class="h-6 w-6 text-accent" /></span>
    <ul class="flex gap-6">
      {socials.map(([name, href]) => <li><a href={href} target="_blank" rel="noopener" class="hover:text-fg">{name} ↗</a></li>)}
    </ul>
  </footer>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const original = b.textContent;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = b.dataset.copied!;
        setTimeout(() => (b.textContent = original), 1800);
      } catch { /* sin permiso de portapapeles */ }
    });
  });

</script>
