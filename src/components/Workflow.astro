---
import type { Lang } from '../data/profile';
import { workflow, setup } from '../data/profile';
import { t } from '../data/i18n';
import Sketch from './Sketch.astro';
import SketchFlight from './SketchFlight.astro';
import type { SketchName } from '../data/sketches';
const icons: SketchName[] = ['understand', 'design', 'build', 'measure', 'ship'];
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<section id="workflow" class="relative overflow-hidden px-5 py-16 md:px-10 md:py-32">
  <SketchFlight icon="ship" seed={111} variant={0} tilt={20} class="pointer-events-none absolute right-4 h-auto w-[48vw] max-w-[26rem] text-accent opacity-80 md:right-10 top-20" />
  <p class="kicker mb-10">{s.workflow.kicker}</p>
  <h2 data-split class="display max-w-5xl text-5xl font-bold md:text-8xl">{s.workflow.title}</h2>
  <Sketch name="scribble" seed={17} draw="scrub" class="mt-3 h-5 w-2/3 max-w-3xl text-accent" />
  <div class="mt-12 md:hidden">
  <ol data-stack class="border-t border-line">
    {workflow.map((w, i) => (
      <li data-stack-item class="border-b border-line">
        <div class="flex items-baseline gap-3 py-3">
          <span class="w-6 shrink-0 font-mono text-xs text-muted">0{i + 1}</span>
          <h3 data-stack-name class="display text-2xl font-semibold">{w.title[lang]}</h3>
        </div>
        <div data-stack-body>
          <div><div class="flex items-start gap-4 pb-5 pl-9">
            <Sketch name={icons[i]} seed={i + 2} draw={false} class="h-12 w-12 shrink-0 text-accent" />
            <p class="text-muted">{w.body[lang]}</p>
          </div></div>
        </div>
      </li>
    ))}
  </ol>
  </div>
  <ol class="mt-20 hidden gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid md:grid-cols-2 lg:grid-cols-5">
    {workflow.map((w, i) => (
      <li class="group bg-bg p-8 transition-colors hover:bg-accent hover:text-accent-ink" data-reveal data-reveal-delay={i * 0.06} data-draw-host>
        <span class="font-mono text-xs opacity-60">0{i + 1}</span>
        <Sketch name={icons[i]} seed={i + 2} class="mt-6 h-14 w-14 text-accent transition-colors group-hover:text-accent-ink" />
        <h3 class="display mt-6 text-3xl font-semibold">{w.title[lang]}</h3>
        <p class="mt-4 text-muted group-hover:text-accent-ink/80">{w.body[lang]}</p>
      </li>
    ))}
  </ol>
  <div class="mt-10 hidden flex-wrap items-center gap-2 md:flex" data-reveal>{/* en celular no: repite herramientas que ya están en Stack */}
    <span class="kicker mr-2">{s.workflow.setup}</span>
    {setup.map((x) => <span class="rounded-full border border-line px-3 py-1 font-mono text-xs">{x}</span>)}
  </div>
</section>
