---
import type { Lang } from '../data/profile';
import { liveProjects } from '../data/profile';
import { t, paths } from '../data/i18n';
import Sketch from './Sketch.astro';
import SketchFlight from './SketchFlight.astro';
/**
 * "En vivo": proyectos con `live` en profile.ts. Cada tarjeta abre el caso de estudio
 * (ahí está el botón al sitio real). `exclude` = slug a omitir (la página actual).
 */
interface Props { lang: Lang; exclude?: string }
const { lang, exclude } = Astro.props;
const s = t(lang);
const items = liveProjects.filter((p) => p.slug !== exclude);
---
{items.length > 0 && (
  <section id="live" class="relative overflow-hidden border-t border-line px-5 py-16 md:px-10 md:py-24">
    <SketchFlight icon="homelab" seed={81} variant={1} class="pointer-events-none absolute right-4 top-8 h-auto w-[50vw] max-w-[26rem] text-accent opacity-80 md:right-10" />
    <p class="kicker mb-6 flex items-center gap-2"><Sketch name="waves" seed={9} class="h-6 w-10 text-accent" />{s.live.kicker}</p>
    <h2 data-split class="display max-w-4xl text-4xl font-bold md:text-6xl">{s.live.title}</h2>
    <p data-reveal class="mt-6 max-w-2xl text-muted">{s.live.body}</p>
    {/* En celular: tira deslizable (cada tarjeta al 80 % para que se asome la siguiente); desde md: grilla */}
    <ul class="-mx-5 mt-8 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:mt-12 md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:px-0 md:pb-0 xl:grid-cols-4">
      {items.map((p, i) => (
        <li data-reveal data-reveal-delay={i * 0.06} class="h-auto w-[80%] shrink-0 snap-start md:h-full md:w-auto">
          <a href={paths.project(lang, p.slug)} data-hover data-draw-host class="group relative flex h-full flex-col rounded-2xl border border-line bg-bg-2 p-5 transition-colors hover:border-[var(--c)] md:p-6" style={`--c:${p.accent}`}>
            <span class="flex items-center gap-2 font-mono text-xs text-muted">
              <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-60" style={`background:${p.accent}`}></span><span class="relative inline-flex h-2 w-2 rounded-full" style={`background:${p.accent}`}></span></span>
              {p.live}
            </span>
            {p.doodle && <Sketch name={p.doodle} seed={i + 91} class="absolute right-5 top-5 h-12 w-12 text-[var(--c)] opacity-90 md:h-16 md:w-16" />}
            <span class="display mt-3 block text-2xl font-semibold transition-colors group-hover:text-[var(--c)] md:mt-4 md:text-3xl">{p.name}</span>
            <span class="mt-2 block flex-1 text-muted">{p.tagline[lang]}</span>
            <span class="mt-4 font-mono text-xs transition-colors group-hover:text-[var(--c)] md:mt-6">{s.live.details} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
