---
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { t, paths } from '../data/i18n';
import PhotoLayers from './PhotoLayers.astro';
import Marked from './Marked.astro';
import Sketch from './Sketch.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const [lead, ...rest] = profile.about[lang];
// "Días programando": se calcula en el build y se actualiza en el navegador (el sitio es estático)
const daysSince = (d: string) => Math.floor((Date.now() - new Date(d).getTime()) / 86_400_000);
const stats = profile.stats.map((st) => (st.days ? { ...st, count: daysSince(profile.codingSince) } : st));
---
<section id="about" class="px-5 py-20 md:px-10 md:py-48">
  <h2 class="kicker mb-10">{s.about.kicker}</h2>
  <p data-words class="display max-w-6xl text-3xl font-medium md:text-7xl">{lead}</p>
  <div class="mt-12 grid items-center gap-10 md:mt-20 md:grid-cols-12 md:gap-12">
    <figure class="relative mx-auto w-full max-w-[18rem] md:col-span-4 md:mx-0 md:max-w-[26rem]">
      <PhotoLayers lang={lang} />
      <!-- Flecha a mano "yo" apuntando a la foto (solo desde md: en móvil no hay espacio al costado) -->
      <div class="pointer-events-none absolute -right-28 top-4 hidden w-28 text-accent md:block lg:-right-32 lg:w-32" aria-hidden="true">
        <span class="font-hand absolute -top-7 right-0 text-3xl">{s.about.me}</span>
        <Sketch name="arrow" seed={4} class="h-auto w-full" />
      </div>
      <figcaption class="kicker mt-4 flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span>{profile.location[lang]}</figcaption>
    </figure>
    <div class="space-y-6 text-lg text-muted md:col-span-7 md:col-start-6 md:text-xl">
      {rest.map((p, i) => <p data-reveal data-reveal-delay={i * 0.08}><Marked text={p} /></p>)}
      <a data-reveal href={paths.about(lang)} data-hover class="inline-flex items-center gap-2 pt-2 text-accent underline-offset-4 hover:underline">{s.about.more} →</a>
    </div>
  </div>
  <dl class="mt-14 grid md:mt-24 grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
    {stats.map((st) => (
      <div class="bg-bg p-6 md:p-8" data-reveal>
        <dt class="kicker">{st.label[lang]}</dt>
        <dd class="display mt-4 text-5xl font-bold md:text-7xl">
          <span class="relative inline-block">
            <span data-count={st.count} data-suffix={st.suffix} data-since={st.days ? profile.codingSince : undefined}>{st.count.toLocaleString(lang)}{st.suffix}</span>
            {st.days && <Sketch name="circle" seed={12} class="pointer-events-none absolute -left-4 -top-3 h-[calc(100%+1.5rem)] w-[calc(100%+2rem)] text-accent" />}
          </span>
        </dd>
      </div>
    ))}
  </dl>
</section>
<script>
  // Mantener "días programando" al día aunque el sitio se haya generado hace días
  document.querySelectorAll<HTMLElement>('[data-since]').forEach((el) => {
    const days = Math.floor((Date.now() - new Date(el.dataset.since!).getTime()) / 86_400_000);
    el.dataset.count = String(days);
    el.textContent = days.toLocaleString(document.documentElement.lang) + (el.dataset.suffix ?? '');
  });
</script>
